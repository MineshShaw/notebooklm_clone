GROQ_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PORT=
PINECONE_CLOUD=
PINECONE_REGION=
FRONTEND_URL=http://localhost:3000

# --- RAG Version 2 (accuracy pipeline) ---
# Step 2: rewrite vague questions before embedding (true | false)
ENABLE_QUERY_REWRITE=true
# Lightweight Groq model for query rewrite (one call per chat)
QUERY_REWRITE_MODEL=llama-3.1-8b-instant
# Prior chat turns sent to rewriter (user + assistant messages)
QUERY_REWRITE_MAX_HISTORY_MESSAGES=6
# Log original vs rewritten query and pipeline details to console
RAG_DEBUG=false

# Step 3: dense (Pinecone) + BM25 fusion (true | false)
ENABLE_HYBRID_RETRIEVAL=true
# How many chunks to keep after fusion (larger pool for reranking later)
RETRIEVAL_TOP_K=24
# Fusion weights (dense = semantic, sparse = BM25 keywords)
DENSE_RETRIEVAL_WEIGHT=0.5
SPARSE_RETRIEVAL_WEIGHT=0.5

# Step 4: batched LLM chunk relevance filter (true | false)
ENABLE_CHUNK_EVALUATOR=true
CHUNK_EVALUATOR_MODEL=llama-3.1-8b-instant
# Chunks passed to answer generator after filtering
RERANK_TOP_K=8
# Drop chunks scored below this (0-10 scale)
CHUNK_RELEVANCE_MIN_SCORE=5
# Final grounded answer model
RESPONSE_GENERATION_MODEL=llama-3.3-70b-versatile
# Step 5: inline [1] [2] citations in answers (true | false)
ENABLE_INLINE_CITATIONS=true
# Prior chat turns in generation prompt (disambiguation only)
GENERATION_MAX_HISTORY_MESSAGES=4
